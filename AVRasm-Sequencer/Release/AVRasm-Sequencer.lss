0003d0 9100 0139                     lds temp, Prev_KP_C
0003d2 2300                          tst temp ; test for 0
0003d3 f429                          brne Skip_KP_C ; state didn't change, skip
                                 
0003d4 e001                          ldi temp, 1
0003d5 9300 0139                     sts Prev_KP_C, temp ; store new state (1)
                                     ; ! DON'T FORGET TO RESTORE TO 0 LATER (like at Metronome ISR?)
                                 
                                     ; -- it changed to 0 (aka pressed)
                                 
0003d7 ef1f                          ldi r17, 0xFF ; special idx meaning "no note" or "mute"
0003d8 d060                          rcall Set_Current_Sequence_Note ; input is r17 = note idx
                                 
                                     Skip_KP_C:
0003d9 910f                          pop temp
0003da 9508                          ret
                                 ; ===#===
                                 
                                 ; ; === handle play pause btn ===
                                 ; Play_Pause_btn:
                                 ;     ; toggle play/pause state
                                 ;     ; -- edge detection
                                 ;     lds r22, Prev_JS_Click
                                 ;     cpi r22, 1 ; was prev state click 1 ?
                                 ;     breq Skip_Click_Check ; if state hasn't changed (still click), do nothing
                                 ;     ldi r22, 1 ; new state is click 1
                                 ;     sts Prev_JS_Click, r22 ; save new state
                                 ;     ; ! DON'T FORGET TO SET BACK TO 0 AFTER RELEASED
                                 ;     ; -- toggle play/pause state
                                 ;     ; TODO: implement
                                 ;     rcall Toggle_Play_Pause
                                 ;     Skip_Click_Check:
                                 ;     ret
                                 ; ; ===#===
                                 
                                 ; === handle manual sequencer steps ===
                                 Next_Step_btn:
0003db 930f                          push temp
0003dc 936f                          push r22
                                     ; advance to next step in sequence
                                     ; -- edge detection
0003dd 9160 012c                     lds r22, Prev_JS_Right
0003df 3061                          cpi r22, 1 ; was prev state right 1 ?
0003e0 f051                          breq Skip_Right_Check ; if state hasn't changed (still right), do nothing
0003e1 e061                          ldi r22, 1 ; new state is right 1
0003e2 9360 012c                     sts Prev_JS_Right, r22 ; save new state
                                     ; ! DON'T FORGET TO SET BACK TO 0 AFTER RELEASED
                                 
0003e4 d204                          rcall Next_Step
0003e5 dceb                          rcall Draw_Step
0003e6 d21c                          rcall LED2_ON ; FIXME: DEBUG
                                 
                                     ; if paused, play the note at the new step
0003e7 9100 0127                     lds temp, Is_Playing
0003e9 ff00                          sbrs temp, 0 ; Skip if bit 0 is set (playing)
0003ea d016                          rcall play_new_step_note_manual ; If paused, play the note
                                 
                                     Skip_Right_Check:
0003eb 916f                          pop r22
0003ec 910f                          pop temp
0003ed 9508                          ret
                                 
                                 Prev_Step_Btn:
0003ee 930f                          push temp
0003ef 936f                          push r22
                                     ; move back to previous step in sequence
                                     ; -- edge detection
0003f0 9160 012b                     lds r22, Prev_JS_Left
0003f2 3061                          cpi r22, 1 ; was prev state left 1 ?
0003f3 f051                          breq Skip_Left_Check ; if state hasn't changed (still left), do nothing
0003f4 e061                          ldi r22, 1 ; new state is left 1
0003f5 9360 012b                     sts Prev_JS_Left, r22 ; save new state
                                     ; ! DON'T FORGET TO SET BACK TO 0 AFTER RELEASED
                                 
0003f7 d1fe                          rcall Prev_Step
0003f8 dcd8                          rcall Draw_Step
0003f9 d20d                          rcall LED3_ON ; FIXME: DEBUG
                                 
                                     ; if paused, play the note at the new step
0003fa 9100 0127                     lds temp, Is_Playing
0003fc ff00                          sbrs temp, 0 ; Skip if bit 0 is set (playing)
0003fd d003                          rcall play_new_step_note_manual ; If paused, play the note
                                 
                                     Skip_Left_Check:
0003fe 916f                          pop r22
0003ff 910f                          pop temp
000400 9508                          ret
                                 
                                 play_new_step_note_manual:
000401 93ef                          push ZL
000402 93ff                          push ZH
000403 931f                          push r17
000404 930f                          push temp
                                 
                                     ; -- play note for current step
000405 9110 0120                     lds r17, Step ; get current step index
000407 e0e0                          ldi ZL, low(Sequence)
000408 e0f1                          ldi ZH, high(Sequence)
000409 2700                          clr temp ; clear temp for high byte addition
00040a 0fe1                          add ZL, r17 ; add step index to z pointer to point to current step's note in sequence
00040b 1ff0                          adc ZH, temp ; add carry to high byte (ZH) from low byte addition
00040c 8110                          ld r17, Z ; load current step's note index into r17
00040d d10b                          rcall Play_Note ; play the note for the current step (r17 is input idx)
                                 
00040e 910f                          pop temp
00040f 911f                          pop r17
000410 91ff                          pop ZH
000411 91ef                          pop ZL
000412 9508                          ret
                                 ; ===#===
                                 
                                 ; === handle BPM changes from joystick ===
                                 Incr_BPM_btn:
000413 930f                          push temp
000414 931f                          push r17
                                 
                                     ; -- edge detection
000415 9100 012a                     lds temp, Prev_JS_Up
000417 2300                          tst temp ; test for 0
000418 f451                          brne Skip_Incr_BPM_btn ; state didn't change, skip
                                 
000419 e001                          ldi temp, 1
00041a 9300 012a                     sts Prev_JS_Up, temp ; store new state (1)
                                     ; DO NOT FORGET TO RESTORE TO 0 LATER (like at Metronome ISR?)
                                 
                                     ; -- increase bpm
00041c 9110 0126                     lds r17, Current_BPM
00041e 3c18                          cpi r17, MAX_BPM
00041f f418                          brsh Incr_BPM_btn_end ; BPM already at max value
000420 9513                          inc r17
000421 d120                          rcall Update_BPM ; will also save to SRAM
000422 d1e0                          rcall LED2_ON ; FIXME: DEBUG
                                 
                                     Incr_BPM_btn_end:
                                     Skip_Incr_BPM_btn:
000423 911f                          pop r17
000424 910f                          pop temp
000425 9508                          ret
                                 
                                 Decr_BPM_btn:
000426 930f                          push temp
000427 931f                          push r17
                                 
                                     ; -- edge detection
000428 9100 0129                     lds temp, Prev_JS_Down
00042a 2300                          tst temp ; test for 0
00042b f451                          brne Skip_Decr_BPM_btn ; state didn't change, skip
                                 
00042c e001                          ldi temp, 1
00042d 9300 0129                     sts Prev_JS_Down, temp ; store new state (1)
                                     ; DO NOT FORGET TO RESTORE TO 0 LATER (like at Metronome ISR?)
                                 
                                     ; -- decrease bpm
00042f 9110 0126                     lds r17, Current_BPM
000431 331d                          cpi r17, MIN_BPM+1
000432 f018                          brlo Decr_BPM_btn_end ; BPM already at min value
000433 951a                          dec r17
000434 d10d                          rcall Update_BPM ; will also save to SRAM
000435 d1d1                          rcall LED3_ON ; FIXME: DEBUG
                                 
                                     Decr_BPM_btn_end:
                                     Skip_Decr_BPM_btn:
000436 911f                          pop r17
000437 910f                          pop temp
000438 9508                          ret
                                 ; ===#===
                                 
                                 ; === Set Current Sequence Note ===
                                 ; input r17 is note idx to put at the current step
                                 Set_Current_Sequence_Note:
000439 93ef                          push ZL
00043a 93ff                          push ZH
00043b 932f                          push r18
00043c 930f                          push temp
                                 
                                     ; get the current step, 0-31
00043d 9120 0120                     lds r18, Step
                                 
                                     ; set z pointer to start of Sequence
00043f e0e0                          ldi ZL, low(Sequence)
000440 e0f1                          ldi ZH, high(Sequence)
                                 
                                     ; add Step offset to z pointer (Sequence + Step)
000441 2700                          clr temp
000442 0fe2                          add ZL, r18
000443 1ff0                          adc ZH, temp
                                 
                                     ; store the newest note into SRAM
000444 8310                          st Z, r17
                                 
                                     ; update the screen
000445 dca0                          rcall Draw_Sequence
                                 
                                     ; play note instantly to hear it
000446 d0d2                          rcall Play_Note
                                 
000447 910f                          pop temp
000448 912f                          pop r18
000449 91ff                          pop ZH
00044a 91ef                          pop ZL
00044b 9508                          ret
                                 ; ===#===
                                 ; ===#===
                                 
                                 .include "defines.asm" ; all the notes timer overeflow declarations etc
                                 
