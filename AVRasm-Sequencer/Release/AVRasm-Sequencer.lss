                                 ; ===#===
                                 
                                 .equ MAX_BPM = 200
                                 .equ MIN_BPM = 60
                                 
                                 ; === Default Startup Melody Data ===
                                 ; 0xFF is blank note (mute)
                                 ; NOTE: these were generated using an LLM !
                                 ;       (i'm not a musician and dont know music theory)
                                 
                                 ; Ode to Joy (Octave 4), 32 steps
                                 ; Preset_Melody_1:
                                 ;     ; Measure 1: E, E, F, G
                                 ;     .db 40, 0xFF, 40, 0xFF, 41, 0xFF, 43, 0xFF
                                 ;     ; Measure 2: G, F, E, D
                                 ;     .db 43, 0xFF, 41, 0xFF, 40, 0xFF, 38, 0xFF
                                 ;     ; Measure 3: C, C, D, E
                                 ;     .db 36, 0xFF, 36, 0xFF, 38, 0xFF, 40, 0xFF
                                 ;     ; Measure 4: E (dotted), D (eighth), D (half)
                                 ;     .db 40, 0xFF, 0xFF, 38, 38, 0xFF, 0xFF, 0xFF
                                 
                                 ; Super Mario Bros - Overworld Theme (32 steps)
                                 ; Preset_Melody_2:
                                 ;     ; Measure 1: E4, E4, (rest), E4, (rest), C4, E4, (rest)
                                 ;     .db 40, 40, 0xFF, 40, 0xFF, 36, 40, 0xFF
                                 ;     ; Measure 2: G4, (restx3), G3, (restx3)
                                 ;     .db 43, 0xFF, 0xFF, 0xFF, 31, 0xFF, 0xFF, 0xFF
                                 ;     ; Measure 3: C4, (restx2), G3, (restx2), E3, (rest)
                                 ;     .db 36, 0xFF, 0xFF, 31, 0xFF, 0xFF, 28, 0xFF
                                 ;     ; Measure 4: (rest), A3, (rest), B3, (rest), Bb3, A3, (rest)
                                 ;     .db 0xFF, 33, 0xFF, 35, 0xFF, 34, 33, 0xFF
                                 
                                 ; Tetris Theme (Korobeiniki) - 32 steps (Lower Octave)
                                 ; Preset_Melody_3:
                                 ;     ; Measure 1: E4 (quarter), B3 (8th), C4 (8th), D4 (quarter), C4 (8th), B3 (8th)
                                 ;     .db 40, 0xFF, 35, 36, 38, 0xFF, 36, 35
                                 ;     ; Measure 2: A3 (quarter), A3 (8th), C4 (8th), E4 (quarter), D4 (8th), C4 (8th)
                                 ;     .db 33, 0xFF, 33, 36, 40, 0xFF, 38, 36
                                 ;     ; Measure 3: B3 (dotted-quarter), C4 (8th), D4 (quarter), E4 (quarter)
                                 ;     .db 35, 0xFF, 35, 36, 38, 0xFF, 40, 0xFF
                                 ;     ; Measure 4: C4 (quarter), A3 (quarter), A3 (quarter), (rest)
                                 ;     .db 36, 0xFF, 33, 0xFF, 33, 0xFF, 0xFF, 0xFF
                                 
                                 ;; Star Wars - Main Theme (32 steps) ; doesn't sound good
                                 ;; Default_Melody_no:
                                 ;;     ; Measure 1: C3 (Half), G3 (Half)
                                 ;;     .db 24, 24, 24, 0xFF, 31, 31, 31, 31
                                 ;;     ; Measure 2: F3, E3, D3 (Triplet-ish), C4 (Half)
                                 ;;     .db 30, 28, 26, 0xFF, 36, 36, 36, 36
                                 ;;     ; Measure 3: G3 (Half), F3, E3, D3 (Triplet-ish)
                                 ;;     .db 31, 31, 31, 31, 30, 28, 26, 0xFF
                                 ;;     ; Measure 4: C4 (Half), G3 (Half)
                                 ;;     .db 36, 36, 36, 0xFF, 31, 31, 31, 31
                                 
                                 ; Imperial March (Darth Vader's Theme) - 32 steps
                                 ; Preset_Melody_4:
                                 ;     ; Measure 1: G3, G3, G3, Eb3 (8th), Bb3 (16th)
                                 ;     .db 31, 0xFF, 31, 0xFF, 31, 0xFF, 27, 34
                                 ;     ; Measure 2: G3 (quarter), Eb3 (8th), Bb3 (16th), G3 (half)
                                 ;     .db 31, 0xFF, 27, 34, 31, 0xFF, 0xFF, 0xFF
                                 ;     ; Measure 3: D4, D4, D4, Eb4 (8th), Bb3 (16th)
                                 ;     .db 38, 0xFF, 38, 0xFF, 38, 0xFF, 39, 34
                                 ;     ; Measure 4: Gb3 (quarter), Eb3 (8th), Bb3 (16th), G3 (half)
                                 ;     .db 30, 0xFF, 27, 34, 31, 0xFF, 0xFF, 0xFF
                                 
                                 ; Seven Nation Army - The White Stripes (32 steps), sounds best around 70bpm
                                 Default_Melody:
                                     ; --- FIRST LOOP ---
                                     ; Measure 1: E4 (dotted quarter), E4 (8th), G4 (8th), E4 (8th), D4 (8th)
000509 2828
00050a ff28
00050b 2b28
00050c 2628                          .db 40, 40, 40, 0xFF, 40, 43, 40, 38
                                     ; Measure 2: C4 (half), B3 (half)
00050d 2424
00050e ff24
00050f 2323
000510 ff23                          .db 36, 36, 36, 0xFF, 35, 35, 35, 0xFF
                                     ; --- SECOND LOOP ---
                                     ; Measure 3: E4 (dotted quarter), E4 (8th), G4 (8th), E4 (8th), D4 (8th)
000511 2828
000512 ff28
000513 2b28
000514 2628                          .db 40, 40, 40, 0xFF, 40, 43, 40, 38
                                     ; Measure 4: C4 (half), B3 (half)
000515 2424
000516 ff24
000517 2323
000518 ff23                          .db 36, 36, 36, 0xFF, 35, 35, 35, 0xFF
                                 
                                 ; ===#===
                                 
                                 ; example:
                                 ;Play_Note_C4:
                                 ;    ; CRITICAL: In AVR asm must write  HIGH byte of a 16-bit register first, then the LOW byte. The hardware latches it.
                                 ;    ldi temp, high(NOTE_C4)
                                 ;    sts OCR1AH, temp
                                 ;    ldi temp, low(NOTE_C4)
                                 ;    sts OCR1AL, temp
                                 ;
                                 ;    ; ; Ensure the timer is connected to the pin (un-mute)
                                 ;    ; ldi temp, (1<<COM1A0)
                                 ;    ; sts TCCR1A, temp
                                 ;    ret
                                 
                                 
                                 ; === play the note from r17 (input), byte is index of note, 0x00-0x18/0x30 aka 0 to 48, or 0xFF (mute) ===
                                 Play_Note:
000519 932f                          push r18
00051a 933f                          push r19
00051b 934f                          push r20
00051c 93ef                          push ZL ; aka r30
00051d 93ff                          push ZH ; aka r31
                                     ; -- no note ?
00051e 3f1f                          cpi r17, 0xFF
00051f f0b1                          breq Note_Mute
                                 
                                     ; -- check if OOB memory location ? outside the lut
000520 3310                          cpi r17, NB_NOTES ; because 25/49 notes (or 0x19) => .set/.equ above
000521 f4ac                          brge End_Play_Note ; if index >= 25, skip to end
                                     ; -- compute byte offset (word is 2 bytes, aka 16bits), 16 bit mult by 2:
000522 2f21                          mov r18, r17 ; MOVe lut index to r18 (keep r17 intact)
000523 2733                          clr r19 ; CLeaR r19 for the high byte of the offset
000524 0f22                          lsl r18 ; Logical Shift Left (mult r18 by 2) (MSB goes in the Carry Flag (C))
000525 1f33                          rol r19 ; ROtate Left thrpugh carry r19, here just pulls the shifted MSB from r18 in the Carry Flag (to handle numbers > 127)
                                 
                                     ; -- set up z pointer: r31(ZH)-r30(ZL) (flash mem is word-based, but `lpm` uses bytes for addresses, need to mult by 2 the note index of the lut)
000526 e9e8                          ldi ZL, low(Note_Table * 2)
000527 e0f8                          ldi ZH, high(Note_Table * 2)
                                     ; -- add offset to z pointer
000528 0fe2                          add ZL, r18
000529 1ff3                          adc ZH, r19 ; ADd with Carry for the high byte (ZH = ZH + r19 + Carry_Flag from add above)
                                     ; -- get data from lut in flash (little endian: low byte first, then high byte last)
00052a 9135                          lpm r19, Z+ ; read low byte, then increment Z pointer
00052b 9144                          lpm r20, Z ; read high byte
                                 
                                     ; -- write val to timer 1 (high byte written first!)
00052c 9340 0089                     sts OCR1AH, r20
00052e 9330 0088                     sts OCR1AL, r19
                                 
                                     ; -- check if switch is off (disable sound)
000530 9b18                          sbis SW_SENSE, SW_I ; Skip if Bit in I/o reg is Set
000531 c004                          rjmp Note_Mute ; disable sound if input pin of switch is low
                                 
                                     ; -- unmute buzzer
000532 e400                          ldi temp, (1<<COM1A0) ; COM1A1:0 = 01 -> Toggle OC1A on Compare Match (TCCR1A) ; 1<<COM1A0
000533 9300 0080                     sts TCCR1A, temp
                                 
000535 c001                          rjmp End_Play_Note
                                 
                                 Note_Mute:
                                     ; no note (mute)
000536 d006                          rcall Mute_Buzzer
                                 
                                 End_Play_Note:
000537 91ff                          pop ZH
000538 91ef                          pop ZL
000539 914f                          pop r20
00053a 913f                          pop r19
00053b 912f                          pop r18
                                 
00053c 9508                          ret
                                 ; ===#===
                                 
                                 ; === to mute: ===
                                 Mute_Buzzer:
                                     ; disconnect the timer "hardware" from PB1 by clearing COM1A0, this mutes the buzzer
00053d e000                          ldi temp, 0b00 ; COM1A1:0 = 00 -> normal operation (OC1A disconnected) ; just 0
00053e 9300 0080                     sts TCCR1A, temp
                                     ; force pin LOW to prevent DC current from damaging the buzzer ?
000540 9829                          cbi BZ_P, BZ_I
000541 9508                          ret
                                 ; ===#===
                                 
                                 ; -- Use Timer 2 for the metronome
                                 ; 16MHz clock, prescaler at 64 => 250 000 ticks/sec
                                 ; for 1ms: (250000 / 1000) - 1 = 249 (into OCR2A)
                                 ; let's use a "16th-note" step (whatever that means i'm not a musician)
                                 ; target delay is:
                                 ; 60000 / (BPM * 4) = Tempo_Delay
                                 
                                 ; === Update BPM ===
                                 ; input r17 is target BPM (must be between 60 and 200 !)
                                 Update_BPM:
000542 930f                          push temp
                                     ;push r17
000543 932f                          push r18
000544 933f                          push r19
000545 93ef                          push ZL
000546 93ff                          push ZH
                                 
000547 9310 0126                     sts Current_BPM, r17 ; store current BPM in SRAM for reference
                                 
                                     ; r17 is BPM input for drawing it
000549 dbcf                          rcall Draw_BPM
                                 
                                     ; substract MIB_BPM to get the BPM table idx (0 to 140), because we used BPMs b/w 60 and 200
00054a 531c                          subi r17, MIN_BPM
                                 
                                     ; mltiply idx by 2 (because .dw uses 2 bytes)
00054b 2f21                          mov r18, r17 ; MOVe lut index to r18 (keep r17 intact)
00054c 2733                          clr r19 ; CLeaR r19 for the high byte of the offset
00054d 0f22                          lsl r18 ; Logical Shift Left (mult r18 by 2) (MSB goes in the Carry Flag (C))
00054e 1f33                          rol r19 ; ROtate Left thrpugh carry r19, here just pulls the shifted MSB from r18 in the Carry Flag
                                 
                                     ; set z pointer to table origin
00054f efe8                          ldi ZL, low(BPM_Table * 2)
000550 e0f8                          ldi ZH, high(BPM_Table * 2)
                                 
                                     ; add the offset to the z pointer
000551 0fe2                          add ZL, r18
000552 1ff3                          adc ZH, r19
                                 
                                     ; get 16-bit delay value
000553 9125                          lpm r18, Z+ ; read low byte
000554 9134                          lpm r19, Z  ; read high byte
                                 
                                     ; safely update the SRAM metronome varq
                                     ; (to prevent the ISR from reading half a new value while writing it, temporarily disable interrupts)
000555 94f8                          cli
000556 9320 0124                     sts Tempo_Delay, r18
000558 9330 0125                     sts Tempo_Delay+1, r19
00055a 9478                          sei ; reenable interrupts
                                 
                                     ; restore
00055b 91ff                          pop ZH
00055c 91ef                          pop ZL
00055d 913f                          pop r19
00055e 912f                          pop r18
                                     ;pop r17
00055f 910f                          pop temp
000560 9508                          ret
                                 ; ===#===
                                 
                                 ; === Setup sequence, runs once on startup ===
                                 setup:
                                     ; initialize stack pointer (just to be sure), not necessary
                                     ;ldi temp, high(RAMEND)
                                     ;out SPH, temp
                                     ;ldi temp, low(RAMEND)
                                     ;out SPL, temp
                                 
                                 	; -- init playing state
000561 e000                          ldi temp, 0; default to playing or paused (0:paused, 1:playing) ; TODO: choose which?
000562 9300 0127                     sts Is_Playing, temp ; paused or playing by default (on startup)
                                 
                                     ; ---- Timer 0 (for display) ----
                                     ; Normal mode, Prescaler = 64 (16MHz / 64 = 250kHz. Overflow at 256 = ~976Hz)
000564 e003                          ldi temp, (1<<CS01) | (1<<CS00)
000565 bd05                          out TCCR0B, temp
000566 e001                          ldi temp, (1<<TOIE0)
000567 9300 006e                     sts TIMSK0, temp
                                 
                                     ; ---- Timer 1 (for notes/sound) ----
                                     ; -- Configure TCCR1A
                                     ; COM1A1:0 = 01 -> Toggle OC1A on Compare Match ; 1<<COM1A0
                                     ; WGM11:0 = 00 -> Lower bits for CTC Mode 4 ; nothing
000569 e400                          ldi temp, (1<<COM1A0)
00056a 9300 0080                     sts TCCR1A, temp
                                     ; -- Configure TCCR1B
                                     ; WGM13:2 = 01 -> Upper bits for CTC Mode 4 (WGM = 0100) ; 1<<WGM12
                                     ; ; CS12:0 = 001 -> Prescaler = 1 ; 1<<CS10
                                     ; CS12:0  = 010 -> Prescaler = 8 (to be able to go to lower octaves) ; 1<<CS11
00056c e00a                          ldi temp, (1<<WGM12) | (1<<CS11)
00056d 9300 0081                     sts TCCR1B, temp
                                     ; ----#----
                                 
                                     ; ---- Timer 2 (for BPM/steps) ----
                                     ; -- Configure TCCR2A
                                     ; COM2A1:0 = 00 -> Normal port operation, OC2A disconnected ; nothing
                                     ; WGM21:0 = 10 -> Lower bits for CTC Mode 2 ; 1<<WGM21
00056f e002                          ldi temp, (1<<WGM21)
000570 9300 00b0                     sts TCCR2A, temp
                                     ; -- Configure TCCR2B
                                     ; WGM22 = 0 -> Upper bit for CTC Mode 2 (WGM = 010) ; nothing
                                     ; CS22:0 = 100 -> Prescaler = 64 ; 1<<CS22
000572 e004                          ldi temp, (1<<CS22)
000573 9300 00b1                     sts TCCR2B, temp
                                     ; -- Configure TIMSK2 (Timer Interrupt MaSK 2)
                                     ; OCIE2A = 1 -> Enable Timer 2 Compare Match A Interrupt
000575 e002                          ldi temp, (1<<OCIE2A)
000576 9300 0070                     sts TIMSK2, temp
                                 
                                     /*
                                     ; !~~~~~~~~~~
                                     ; FIXME:
                                     ; ! temporary for testing, set TIMSK2 to 0 to disable buzzer for now
                                     ldi temp, 0
                                     sts TIMSK2, temp
                                     ; !~~~~~~~~~~
                                     */
                                 
                                     ; -- Configure OCR2A (ceiling value of timer 2)
                                     ; 16MHz / Prescaler 64 = 250,000 ticks/sec
                                     ; ; 1ms resolution => 1000Hz
                                     ; ; 250,000 / 1000Hz = 250 ticks, 0-indexed so 249:
                                     ; ldi temp, 249
                                     ; 0.1ms resolution => 10000Hz
                                     ; 250,000 / 10000Hz = 25 ticks, 0-indexed so 24:
000578 e108                          ldi temp, 24
000579 9300 00b3                     sts OCR2A, temp
                                     ; ----#----
                                 
00057b dc19                          rcall Inputs_Init ; initialize inputs (switch, joystick, keypad)
                                 
                                     ; -- init sequence in SRAM
00057c d018                          rcall Init_Sequence ; clear sequence
                                 
                                     ; -- init step
00057d e000                          ldi temp, 0 ; default step 0
00057e 9300 0120                     sts Step, temp ; store default step in SRAM
                                 
                                     ; -- init octave
000580 e003                          ldi temp, 3 ; default octave 1 (0-3)
000581 9300 0121                     sts Current_Octave, temp ; store default octave in SRAM
                                 
                                     ; -- init bpm
000583 e718                          ldi r17, 120 ; default BPM
000584 dfbd                          rcall Update_BPM ; set BPM (save in SRAM and update Tempo_Delay)
                                 
                                     ; ---- outputs ----
                                     ; -- screen
                                     ;! do not "poison" the other pins on the same port (PORTb)
000585 b104                          in temp, DISPLAY_D ; read current DDRb config to not mess with other pins
000586 6308                          ori temp, (1<<DISPLAY_DATA_I) | (1<<4) | (1<<DISPLAY_CLK_I) ; or with display bits
000587 b904                          out DISPLAY_D, temp
000588 b105                          in temp, DISPLAY_PORT ; read current PORTb config to not mess with other pins
000589 6308                          ori temp, (1<<DISPLAY_DATA_I) | (1<<4) | (1<<DISPLAY_CLK_I) ; or with display bits
00058a b905                          out DISPLAY_PORT, temp
                                 
00058b da95                          rcall Init_Display
                                 
                                     ; -- buzzer output
00058c 9a21                          sbi BZ_D,BZ_I ; set buzzer out pin dir to output(1)
00058d 9829                          cbi BZ_P,BZ_I ; clear buzzer output to low
                                 
                                     ; -- leds output
00058e 9a3a                          sbi LED2_D,LED2_I ;set led2 out pin dir to output(1)
00058f 9842                          cbi LED2_P,LED2_I ;clear led2 to off
000590 9a3b                          sbi LED3_D,LED3_I ;set led3 out pin dir to output(1)
000591 9843                          cbi LED3_P,LED3_I ;clear led3 to off
                                     ; ----#----
                                 
000592 da9a                          rcall Startup_Display ; start the display with initial values shown
000593 9478                          sei ; enable interrupts (Set global Interrupt fags)
000594 c016                          rjmp loop
                                 ; ===#===
                                 
                                 ; === Clear Sequence (stratup) ===
                                 Init_Sequence:
000595 93ef                          push ZL
000596 93ff                          push ZH
000597 93af                      	push XL
000598 93bf                      	push XH
000599 931f                          push r17
00059a 930f                          push temp
                                 
                                     ; -- x pointer to base address of the sequence in SRAM
00059b e0a0                          ldi XL, low(Sequence)
00059c e0b1                          ldi XH, high(Sequence)
                                 
                                 	; -- z pointer to base address of the default melody in Flash mem (only z for Flash!)
00059d e1e2                      	ldi ZL, low(Default_Melody * 2)
00059e e0fa                          ldi ZH, high(Default_Melody * 2)
                                 
                                     ; load rest/mute value
                                     ;ldi temp, 0xFF ; 0xFF means mute
                                 
                                     ; DEBUG:
                                     ;ldi temp, 33 ; NOTE_A3 is idx 33, A (3rd octave) FIXME: for testing
                                 
                                     ; set below loop duration to the 32 steps
00059f e210                          ldi r17, 32
                                 Fill_Sequence:
                                     ; ; store rest/mute value in sequence and auto-increment z pointer to next byte in SRAM
                                     ; st X+, temp
                                     ; ; decr counter and loop if not zero
                                     ; dec r17
                                     ; brne Fill_Sequence
                                     ; ; Sequence is initialized with all mutes/rests
                                 
0005a0 9105                      	lpm temp, Z+ ; load note index from default melody
0005a1 930d                          st X+, temp ; store note index into Sequence
0005a2 951a                          dec r17
0005a3 f7e1                          brne Fill_Sequence
                                 	; Sequence is initialized with the default melody
                                 
                                 
                                 
0005a4 910f                          pop temp
0005a5 911f                          pop r17
0005a6 91bf                      	pop XH
0005a7 91af                      	pop XL
0005a8 91ff                          pop ZH
0005a9 91ef                          pop ZL
0005aa 9508                          ret
                                 ; ===#===
                                 
                                 ; === infinite loop (right after setup) ===
                                 loop:
                                 
0005ab cc21                          rjmp User_Inputs ; handle user inputs (joystick, keypad) ; ? rjmp or rcall ?
                                 
0005ac cffe                          rjmp loop
                                 ; ===#===
                                 
                                 ; === Metronome's ISR ===
                                 ISR_Metronome: ; called every time timer 2 reaches OCR2A (every (1ms or) 0.1ms)
0005ad 930f                          push r16 ; aka temp
0005ae 931f                          push r17
0005af 932f                          push r18
0005b0 933f                          push r19
0005b1 93ef                          push ZL
0005b2 93ff                          push ZH
0005b3 b70f                          in temp, SREG
0005b4 930f                          push temp
                                 
                                     ; -- incr 16-bit Tick Counter
0005b5 9100 0122                     lds r16, Tick_Counter
0005b7 9110 0123                     lds r17, Tick_Counter+1
0005b9 5f0f                          subi r16, low(-1) ; add 1 to low byte
0005ba 4f1f                          sbci r17, high(-1) ; add carry (from low byte) to high byte
0005bb 9300 0122                     sts Tick_Counter, r16
0005bd 9310 0123                     sts Tick_Counter+1, r17
                                 
                                     ; -- reset btn states (joystick and keypad) every 200ms
                                     ; if Tick Counter == 2000 (for 0.1ms)
0005bf 2f20                          mov r18, r16 ; copy low byte of Tick Counter to r18 for comparison
0005c0 2f31                          mov r19, r17 ; copy high byte of Tick Counter to r19 for comparison
0005c1 5828                          subi r18, low(5000) ; 2000 for 0.1ms resolution = 200ms
0005c2 4133                          sbci r19, high(5000) ; sub with carry for high byte
                                     ;brne Skip_Reset_Btn_States ; if not 200ms yet, skip reset ; fixed below
0005c3 f008                          brlo Skip_Reset_Btn_States ; if not 200ms yet, skip reset
0005c4 dc0b                          rcall Reset_Prev_Btn_States
                                     Skip_Reset_Btn_States:
                                 
                                     ; -- compare with Tempo_Delay (e.g. 1249 is 120 BPM)
0005c5 91e0 0124                     lds ZL, Tempo_Delay
0005c7 91f0 0125                     lds ZH, Tempo_Delay+1
0005c9 170e                          cp r16, ZL
0005ca 071f                          cpc r17, ZH
                                     ;brne End_ISR_Metronome ; if delay not reached: exit ; fixed below
0005cb f0a0                          brlo End_ISR_Metronome ; if delay not reached: exit
                                 
                                     ; -- delay reached: reset Tick Counter to 0
0005cc 2700                          clr temp ; aka ldi temp,0
0005cd 9300 0122                     sts Tick_Counter, temp
0005cf 9300 0123                     sts Tick_Counter+1, temp
                                 
                                     ; -- skip playing the note if paused
                                     ; yeah keep running the Metronome even during pause to keep the timing, just skip the note-playing part
0005d1 9100 0127                     lds temp, Is_Playing
0005d3 ff00                          sbrs temp, 0 ; Skip if Bit in Register Set (first bit is 0 if paused, 1 if playing)
0005d4 c00b                          rjmp End_ISR_Metronome ; do not advance step when paused ?
                                 
                                     ; -- play note for current step
0005d5 9110 0120                     lds r17, Step ; get current step index
0005d7 e0e0                          ldi ZL, low(Sequence)
0005d8 e0f1                          ldi ZH, high(Sequence)
0005d9 2700                          clr temp ; clear temp for high byte addition
0005da 0fe1                          add ZL, r17 ; add step index to z pointer to point to current step's note in sequence
0005db 1ff0                          adc ZH, temp ; add carry to high byte (ZH) from low byte addition
0005dc 8110                          ld r17, Z ; load current step's note index into r17
0005dd df3b                          rcall Play_Note ; play the note for the current step (r17 is input idx)
                                 
                                     End_Sequence_Play_Note: ; not used anymore
                                 
                                     ; -- advance sequencer step
0005de d00a                          rcall Next_Step
0005df daf1                          rcall Draw_Step
                                 
                                     End_ISR_Metronome:
                                     ; -- restore stack
0005e0 910f                          pop temp
0005e1 bf0f                          out SREG, temp
0005e2 91ff                          pop ZH
0005e3 91ef                          pop ZL
0005e4 913f                          pop r19
0005e5 912f                          pop r18
0005e6 911f                          pop r17
0005e7 910f                          pop r16
0005e8 9518                          reti
                                 ; ===#===
                                 
                                 Next_Step:
                                     ; advance sequencer step
0005e9 9100 0120                     lds temp, Step
                                     ; check if at end of sequence (32 steps), loop back to 0
0005eb 310f                          cpi temp, 31
0005ec f420                          brsh loop_to_start
0005ed 9503                          inc temp ; next step
0005ee 9300 0120                     sts Step, temp
0005f0 c003                          rjmp End_Next_Step
                                     loop_to_start:
0005f1 2700                          clr temp ; aka ldi temp,0
0005f2 9300 0120                     sts Step, temp
                                     End_Next_Step:
0005f4 dbec                      	rcall Reset_Prev_KP_States ; DO NOT RESET JS STATE
0005f5 9508                          ret
                                 
                                 Prev_Step:
                                     ; move to previous step
0005f6 9100 0120                     lds temp, Step
                                     ; check if at start of sequence (step 0), loop back to end (31)
0005f8 3001                          cpi temp, 1
0005f9 f020                          brlo loop_to_end
0005fa 950a                          dec temp ; previous step
0005fb 9300 0120                     sts Step, temp
0005fd c003                          rjmp End_Prev_Step
                                     loop_to_end:
0005fe e10f                          ldi temp, 31
0005ff 9300 0120                     sts Step, temp
                                     End_Prev_Step:
000601 dbdf                      	rcall Reset_Prev_KP_States ; DO NOT RESET JS STATE
000602 9508                          ret
                                 
                                 ; === outputs ===
                                 LED2_ON:
                                     ; LOW enable
000603 9842                          cbi LED2_P,LED2_I ;set bit of led to high
000604 9508                          ret
                                 LED2_OFF:
000605 9a42                          sbi LED2_P,LED2_I ;set bit of led to low
000606 9508                          ret
                                 LED3_ON:
                                     ; LOW enable
000607 9843                          cbi LED3_P,LED3_I ;set bit of led to high
000608 9508                          ret
                                 LED3_OFF:
000609 9a43                          sbi LED3_P,LED3_I ;set bit of led to low
00060a 9508                          ret
                                 ;BUZON:
                                 ;    ldi R16, 0b1
                                 ;    sts TIMSK0,R16 ; enable timer 0 overflow interrupt
                                 ;    ret
                                 ;BUZOFF:
                                 ;    ldi R16, 0b0
                                 ;    sts TIMSK0,R16 ; disable timer 0 overflow interrupt
                                 ;    ret
                                 ; ===#===
                                 


