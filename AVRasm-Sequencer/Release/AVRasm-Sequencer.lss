                                 ; ATmega328P
                                 .include "m328pdef.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; use:
                                 ; .org !
                                 ; .def
                                 ; .equ
                                 ; .dw
                                 ; .db
                                 ; .set
                                 ; etc
                                 
                                 ; the Z pointer, ZL and ZH are registers R30 and R31, used as a pointer for flash memory access (lpm instruction)
                                 ; the X pointer, XL and XH are registers R26 and R27, used as a pointer for SRAM access (st/ld instructions)
                                 
                                 .def temp = r16 ; example: define alias "temp" for the register "r16"
                                 .def px_x = r20 ; Set_Pixel input, x coordinate (0 to 39)
                                 .def px_y = r21 ; Set_Pixel input, y coordinate (0 to 13)
                                 .def px_state = r22 ; Set_Pixel input, LED pixel state (1=ON, 0=OFF)
                                 
                                 .dseg ; define data segment for SRAM
                                 .org SRAM_START ; (0x0100 ?)
000100                           Sequence: .byte 32 ; 32 bytes for the 32 steps
000120                           Step: .byte 1 ; keep traack of step number (0 to 31)
000121                           Current_Octave: .byte 1 ; keep track of current octave (0 to 4)
000122                           Tick_Counter: .byte 2 ; 16bit counter for milliseconds
000124                           Tempo_Delay: .byte 2 ; 16bit delay (in ms) based on BPM, kinda rounded (sufficiently precise)
000126                           Current_BPM: .byte 1 ; store current BPM (value between 60 and 200)
000127                           Is_Playing: .byte 1 ; boolean to track if the sequencer is currently playing or paused
                                 ; -- store previous joystick state (for edge detection)
000128                           Prev_JS_Click: .byte 1
000129                           Prev_JS_Down: .byte 1
00012a                           Prev_JS_Up: .byte 1
00012b                           Prev_JS_Left: .byte 1
00012c                           Prev_JS_Right: .byte 1
                                 ; -- store previous keypad buttons states (for edge detection)
00012d                           Prev_KP_0: .byte 1
00012e                           Prev_KP_1: .byte 1
00012f                           Prev_KP_2: .byte 1
000130                           Prev_KP_3: .byte 1
000131                           Prev_KP_4: .byte 1
000132                           Prev_KP_5: .byte 1
000133                           Prev_KP_6: .byte 1
000134                           Prev_KP_7: .byte 1
000135                           Prev_KP_8: .byte 1
000136                           Prev_KP_9: .byte 1
000137                           Prev_KP_A: .byte 1
000138                           Prev_KP_B: .byte 1
000139                           Prev_KP_C: .byte 1
00013a                           Prev_KP_D: .byte 1
00013b                           Prev_KP_E: .byte 1
00013c                           Prev_KP_F: .byte 1
                                 ; Screen_Buffer: .byte 70 ; 10 bytes per row * 7 rows (LED diplay) -> 1 bit per LED
                                 ;Screen_Buffer: .byte 560 ; 80(40*2) bytes per row * 7 rows (LED display) -> 1 byte per LED ; set in display.asm file
00013d                           Screen_Buffer: .byte 560 ; entire screen buffer, 1 led to 1 byte
00036d                           Active_Row: .byte 1 ; Tracks the current screen row (electrically, 0 to 6)
00036e                           Current_Melody_Idx: .byte 1 ; index of the current melody in the melody selection (0 to 7, for 8 melodies)
00036f                           Preset_Melody_1: .byte 32 ; preset melody 1 (32 steps)
00038f                           Preset_Melody_2: .byte 32 ; preset melody 2 (32 steps)
0003af                           Preset_Melody_3: .byte 32 ; preset melody 3 (32 steps)
0003cf                           Preset_Melody_4: .byte 32 ; preset melody 4 (32 steps)
0003ef                           User_Melody_1: .byte 32 ; user melody 1 (32 steps)
00040f                           User_Melody_2: .byte 32 ; user melody 2 (32 steps)
00042f                           User_Melody_3: .byte 32 ; user melody 3 (32 steps)
00044f                           User_Melody_4: .byte 32 ; user melody 4 (32 steps)
                                 .cseg
                                 
                                 .org 0x0000
000000 c560                          rjmp setup
                                 
                                 ; timer 0 and 2 are 8bit (up to 255), timer 1 is 16 bit (up to 65535)
                                 ; use timer 1 for the buzzer sound notes
                                 
                                 ; timer2 OVF
                                 .org OC2Aaddr ; timer 2 overflow interrrupt vector
00000e c59e                          rjmp ISR_Metronome
                                 
                                 ; timer0 OVF
                                 .ORG OVF0addr
000020 c015                          RJMP ISR_Display ; Timer 0 Overflow Vector for the Screen Refresh
                                 
                                 ; === display ===
                                 .equ DISPLAY_D = DDRb
                                 .equ DISPLAY_PORT = PORTb
                                 .equ DISPLAY_PIN = PINb
                                 .equ DISPLAY_DATA_I = 3
                                 .equ DISPLAY_CLK_I = 5
                                 .include "display.asm"
                                 
                                 ; display.asm :
                                 ; PROJECT for Sensors and Microsystem Electronics, final file version
                                 ; Date : 2026
                                 ; Author : Lucas Placentino
                                 ; License: MIT
                                 ;
                                 
                                 ;--------
                                 ; MACROS
                                 ;--------
                                 .macro shiftBit_macro
                                     sbi DISPLAY_PORT, DISPLAY_DATA_I
                                     sbrs @0, @1
                                     cbi DISPLAY_PORT, DISPLAY_DATA_I
                                     sbi DISPLAY_PIN, DISPLAY_CLK_I
                                     sbi DISPLAY_PIN, DISPLAY_CLK_I
                                 .endmacro
                                 
                                 Init_Display:
                                 
                                     ; 3. Initialize Active_Row to 0
000021 2700                          CLR temp
000022 9300 036d                     STS Active_Row, temp
                                 
                                     ; 3. Clear the SRAM Buffer to black (0)
000024 d071                          rcall Clear_Screen
                                 
                                     ; ; FIXME: test
                                     ; ldi px_x, 5
                                     ; ldi px_y, 8
                                     ; ldi px_state, 1
                                     ; rcall Set_Pixel
                                 
                                     ; ; FIXME: test
                                     ; LDI px_y, 13          ; Constant Y coordinate
                                     ; LDI px_state, 1       ; State = ON
                                     ; LDI px_x, 0           ; Start X at 0
                                     ; Draw_Bottom_Line:
                                     ; rcall Set_Pixel       ; Draw the current pixel
                                     ; INC px_x              ; Move 1 pixel to the right
                                     ; CPI px_x, 32          ; Compare X with 32 (the limit)
                                     ; BRNE Draw_Bottom_Line ; If X is not 40, loop back and draw the next one
                                 
                                     ; TODO: draw everything once
                                     ; rcall Draw_BPM
                                     ; rcall Draw_Sequence
                                     ; rcall Draw_Octave
                                 
                                     ; -- draw separator line (between sequence and step indicator)
000025 e05c                          ldi px_y, 12
000026 e061                          ldi px_state, 1
000027 e040                          ldi px_x, 0
                                     draw_separator_loop:
000028 d080                          rcall Set_Pixel
000029 9543                          inc px_x
00002a 3240                          cpi px_x, 32
00002b f7e1                          brne draw_separator_loop
                                 
00002c 9508                          ret
                                 
                                 Startup_Display:
00002d 931f                          push r17
00002e 9110 0126                     lds r17, Current_BPM
000030 d0e8                          rcall Draw_BPM
                                 
000031 d0b4                          rcall Draw_Sequence
000032 d0d9                          rcall Draw_Octave
000033 d09d                      	rcall Draw_Step
                                 
000034 911f                          pop r17
000035 9508                          ret
                                 
                                 ;---------------------------------------------------------
                                 ; ISR: Timer 0 Overflow (Screen Multiplexing)
                                 ;---------------------------------------------------------
                                 ISR_Display:
000036 930f                          push temp
000037 b70f                          in temp, SREG
000038 930f                          push temp
000039 920f                          push r0
00003a 921f                          push r1
00003b 931f                          push r17
00003c 932f                          push r18
00003d 933f                          push r19
00003e 937f                          push r23
00003f 93ef                          push ZL
000040 93ff                          push ZH
                                 
000041 9130 036d                     lds r19, Active_Row
                                 
000043 e520                          LDI r18, 80
000044 9f32                          MUL r19, r18
000045 2de0                          MOV ZL, r0
000046 2df1                          MOV ZH, r1
                                 
000047 2722                          CLR r18
000048 0fe2                          ADD ZL, r18
000049 1ff2                          ADC ZH, r18
                                 
00004a 5ce3                          SUBI ZL, low(-Screen_Buffer)
00004b 4ffe                          SBCI ZH, high(-Screen_Buffer)
                                 
00004c e520                          LDI r18, 80
                                 isr_ColLoop:
00004d 9011                          LD r1, Z+
00004e 982b                          CBI DISPLAY_PORT, DISPLAY_DATA_I
00004f fc10                          SBRC r1, 0
000050 9a2b                          SBI DISPLAY_PORT, DISPLAY_DATA_I
000051 9a1d                          SBI DISPLAY_PIN, DISPLAY_CLK_I
000052 9a1d                          SBI DISPLAY_PIN, DISPLAY_CLK_I
000053 952a                          DEC r18
000054 f7c1                          BRNE isr_ColLoop
                                 
000055 982b                          CBI DISPLAY_PORT, DISPLAY_DATA_I
000056 9a1d                          SBI DISPLAY_PIN, DISPLAY_CLK_I
000057 9a1d                          SBI DISPLAY_PIN, DISPLAY_CLK_I
                                 
000058 e470                          LDI r23, 0b1000000
000059 2f03                          MOV temp, r19
00005a 2300                          TST temp
00005b f019                          BREQ skip_shift
                                 shift_mask_loop:
00005c 9576                          LSR r23
00005d 950a                          DEC temp
00005e f7e9                          BRNE shift_mask_loop
                                 skip_shift:
                                 
00005f 9a2b
000060 ff76
000061 982b
000062 9a1d
000063 9a1d                          shiftBit_macro r23, 6
000064 9a2b
000065 ff75
000066 982b
000067 9a1d
000068 9a1d                          shiftBit_macro r23, 5
000069 9a2b
00006a ff74
00006b 982b
00006c 9a1d
00006d 9a1d                          shiftBit_macro r23, 4
00006e 9a2b
00006f ff73
000070 982b
000071 9a1d
000072 9a1d                          shiftBit_macro r23, 3
000073 9a2b
000074 ff72
000075 982b
000076 9a1d
000077 9a1d                          shiftBit_macro r23, 2
000078 9a2b
000079 ff71
00007a 982b
00007b 9a1d
00007c 9a1d                          shiftBit_macro r23, 1
00007d 9a2b
00007e ff70
00007f 982b
000080 9a1d
000081 9a1d                          shiftBit_macro r23, 0
                                 
000082 9a1c                          SBI DISPLAY_PIN, 4
000083 982c                          CBI DISPLAY_PORT, 4
                                 
000084 9533                          INC r19
000085 3037                          CPI r19, 7
000086 f409                          BRNE save_row
000087 2733                          CLR r19
                                 save_row:
000088 9330 036d                     STS Active_Row, r19
                                 
00008a 91ff                          POP ZH
00008b 91ef                          POP ZL
00008c 917f                          POP r23
00008d 913f                          POP r19
00008e 912f                          POP r18
00008f 911f                          pop r17
000090 901f                          POP r1
000091 900f                          POP r0
000092 910f                          POP temp
000093 bf0f                          OUT SREG, temp
000094 910f                          POP temp
000095 9518                          RETI
                                 
                                 ;---------------------------------------------------------
                                 ; Subroutine: Clear_Screen
                                 ; Fills all 560 bytes of the Screen Buffer with 0x00 (Black)
                                 ;---------------------------------------------------------
                                 Clear_Screen:
000096 93ef                          PUSH ZL
000097 93ff                          PUSH ZH
000098 93af                          PUSH XL
000099 93bf                          PUSH XH
00009a 930f                          PUSH temp
                                 
00009b e3ed                          LDI ZL, low(Screen_Buffer)
00009c e0f1                          LDI ZH, high(Screen_Buffer)
                                 
00009d e3a0                          LDI XL, low(560)            ; Use X register pair as a 16-bit counter
00009e e0b2                          LDI XH, high(560)
00009f 2700                          CLR temp                    ; Value to write (0 = OFF)
                                 
                                 clear_loop:
0000a0 9301                          ST Z+, temp                 ; Write 0 and increment Z pointer
0000a1 9711                          SBIW XL, 1                  ; Subtract 1 from the 16-bit counter
0000a2 f7e9                          BRNE clear_loop             ; Loop until the counter hits 0
                                 
0000a3 910f                          POP temp
0000a4 91bf                          POP XH
0000a5 91af                          POP XL
0000a6 91ff                          POP ZH
0000a7 91ef                          POP ZL
0000a8 9508                          RET
                                 
                                 ;---------------------------------------------------------
                                 ; Subroutine: Set_Pixel
                                 ; Input: px_x (r20), px_y (r21), px_state (r22)
                                 ;---------------------------------------------------------
                                 Set_Pixel:
0000a9 933f                          PUSH r19
0000aa 934f                          PUSH px_x
0000ab 935f                          PUSH px_y
0000ac 93ef                          PUSH ZL
0000ad 93ff                          PUSH ZH
0000ae 920f                          PUSH r0
0000af 921f                          PUSH r1
                                 
0000b0 3057                          CPI px_y, 7
0000b1 f438                          BRSH bottom_half_logic
                                 
                                 top_half_logic:
0000b2 e43f                          LDI r19, 79
0000b3 1b34                          SUB r19, px_x
0000b4 2f43                          MOV px_x, r19
0000b5 e036                          LDI r19, 6
0000b6 1b35                          SUB r19, px_y
0000b7 2f53                          MOV px_y, r19
0000b8 c006                          RJMP calc_address
                                 
                                 bottom_half_logic:
0000b9 e237                          LDI r19, 39
0000ba 1b34                          SUB r19, px_x
0000bb 2f43                          MOV px_x, r19
0000bc e03d                          LDI r19, 13
0000bd 1b35                          SUB r19, px_y
0000be 2f53                          MOV px_y, r19
                                 
                                 calc_address:
0000bf e530                          LDI r19, 80
0000c0 9f53                          MUL px_y, r19
0000c1 2de0                          MOV ZL, r0
0000c2 2df1                          MOV ZH, r1
0000c3 2733                          CLR r19
0000c4 0fe4                          ADD ZL, px_x
0000c5 1ff3                          ADC ZH, r19
0000c6 5ce3                          SUBI ZL, low(-Screen_Buffer)
0000c7 4ffe                          SBCI ZH, high(-Screen_Buffer)
0000c8 8360                          ST Z, px_state
                                 
0000c9 901f                          POP r1
0000ca 900f                          POP r0
0000cb 91ff                          POP ZH
0000cc 91ef                          POP ZL
0000cd 915f                          POP px_y
0000ce 914f                          POP px_x
0000cf 913f                          POP r19
0000d0 9508                          RET
                                 
                                 ; === drawing current step ===
                                 Draw_Step:
0000d1 930f                          push temp
0000d2 934f                          push px_x
0000d3 935f                          push px_y
                                 
                                     ; -- clear all steps
0000d4 e000                          ldi temp, 0
0000d5 e05d                          ldi px_y, 13
0000d6 e040                          ldi px_x, 0
0000d7 e060                          ldi px_state, 0
                                 clear_steps_loop:
0000d8 dfd0                          rcall Set_Pixel
0000d9 9543                          inc px_x
0000da 3240                          cpi px_x, 32
0000db f7e1                          brne clear_steps_loop
                                 
                                     ; -- draw current step
0000dc 9100 0120                     lds temp, Step
0000de e05d                          ldi px_y, 13
0000df 2f40                          mov px_x, temp
0000e0 e061                          ldi px_state, 1
0000e1 dfc7                          rcall Set_Pixel
                                 
0000e2 915f                          pop px_y
0000e3 914f                          pop px_x
0000e4 910f                          pop temp
0000e5 9508                          ret
                                 ; ===#===
                                 
                                 ; === drawing the entire sequence ===
                                 Draw_Sequence:
0000e6 930f                          push temp
0000e7 931f                          push r17
0000e8 934f                          push px_x
0000e9 935f                          push px_y
0000ea 936f                          push px_state
0000eb 93ef                          push ZL
0000ec 93ff                          push ZH
                                 
0000ed e0e0                          ldi ZL, low(Sequence)
0000ee e0f1                          ldi ZH, high(Sequence)
0000ef e040                          ldi px_x, 0 ; Start at column 0
                                 
                                 draw_seq_loop:
                                     ; 1. Clear the column for this step (Y=0 to 11)
0000f0 e050                          ldi px_y, 0
0000f1 e060                          ldi px_state, 0
                                 clear_col_loop:
0000f2 dfb6                          rcall Set_Pixel
0000f3 9553                          inc px_y
0000f4 305c                          cpi px_y, 12
0000f5 f7e1                          brne clear_col_loop
                                 
                                     ; 2. Read the note from the Sequence array
0000f6 9111                          ld r17, Z+
0000f7 3f1f                          cpi r17, 0xFF ; Check if it's a rest/mute
0000f8 f041                          breq next_step_draw ; skip drawing if muted
                                 
                                     ; 3. Calculate note index Modulo 12 (pitch class)
                                 mod_12_loop:
0000f9 301c                          cpi r17, 12
0000fa f010                          brlo mod_12_done
0000fb 501c                          subi r17, 12
0000fc cffc                          rjmp mod_12_loop
                                 mod_12_done:
                                 
                                     ; 4. Map to Y coordinate: 11 - note
                                     ; This puts C at the bottom (y=11) and B at the top (y=0)
0000fd e05b                          ldi px_y, 11
0000fe 1b51                          sub px_y, r17
                                 
                                     ; 5. Draw the pixel
0000ff e061                          ldi px_state, 1
000100 dfa8                          rcall Set_Pixel
                                 
                                 next_step_draw:
000101 9543                          inc px_x
000102 3240                          cpi px_x, 32
000103 f761                          brne draw_seq_loop ; Loop for all 32 steps
                                 
000104 91ff                          pop ZH
000105 91ef                          pop ZL
000106 916f                          pop px_state
000107 915f                          pop px_y
000108 914f                          pop px_x
000109 911f                          pop r17
00010a 910f                          pop temp
00010b 9508                          ret
                                 ; ===#===
                                 
                                 ;---------------------------------------------------------
                                 ; Subroutine: Draw_Octave
                                 ; Prints Current_Octave at x=33, y=5
                                 ;---------------------------------------------------------
                                 Draw_Octave:
00010c 93af                          push r26
00010d 934f                          push px_x
00010e 935f                          push px_y
                                 
00010f 91a0 0121                     lds r26, Current_Octave ; Get the current octave (e.g., 0, 1, 2, 3)
                                 
                                     ; Current_Octave is 0-indexed, so add 1
000111 95a3                          inc r26
                                 
000112 e241                          ldi px_x, 33            ; Set X coordinate
000113 e055                          ldi px_y, 5             ; Set Y coordinate
000114 d044                          rcall Draw_Number_3x4   ; Draw the 3x4 digit
                                 
000115 915f                          pop px_y
000116 914f                          pop px_x
000117 91af                          pop r26
000118 9508                          ret
                                 
                                 ;---------------------------------------------------------
                                 ; Subroutine: Draw_BPM
                                 ; Input: r17 (The current BPM, MIN_BPM=60 to MAX_BPM=200)
                                 ;---------------------------------------------------------
                                 Draw_BPM:
                                     ; -- Protect all registers used in this routine --
000119 932f                          PUSH r18
00011a 933f                          PUSH r19
00011b 937f                          PUSH r23    ; Hundreds
00011c 938f                          PUSH r24    ; Tens
00011d 939f                          PUSH r25    ; Units
00011e 93af                          PUSH r26    ; Digit to draw
00011f 934f                          PUSH px_x
000120 935f                          PUSH px_y
000121 93ef                          PUSH ZL
000122 93ff                          PUSH ZH
                                 
                                 ;     ; --- 1. Clear the 3x14 drawing area (avoid ghosting) ---
                                 ;     LDI px_x, 37
                                 ; clear_box_x:
                                 ;     LDI px_y, 0
                                 ; clear_box_y:
                                 ;     LDI px_state, 0
                                 ;     rcall Set_Pixel
                                 ;     INC px_y
                                 ;     CPI px_y, 14
                                 ;     BRNE clear_box_y
                                 ;     INC px_x
                                 ;     CPI px_x, 40
                                 ;     BRNE clear_box_x
                                 
                                     ; --- 1. OPTIMIZED CLEAR (Fix 2) ---
000123 e027                          LDI r18, 7                  ; Loop through the 7 physical hardware rows
000124 e3ed                          LDI ZL, low(Screen_Buffer)
000125 e0f1                          LDI ZH, high(Screen_Buffer)
000126 2700                          CLR temp                    ; temp (r16) = 0 (LED OFF)
                                 
                                 clear_bpm_area:
                                     ; Wipe Visual Columns 37, 38, 39 on Bottom Panel (Hardware cols 0, 1, 2)
000127 8300                          std Z+0, temp
000128 8301                          std Z+1, temp
000129 8302                          std Z+2, temp
                                 
                                     ; Wipe Visual Columns 37, 38, 39 on Top Panel (Hardware cols 40, 41, 42)
00012a a700                          std Z+40, temp
00012b a701                          std Z+41, temp
00012c a702                          std Z+42, temp
                                 
                                     ; Move Z to the start of the next 80-byte hardware row
00012d e530                          LDI r19, 80
00012e 0fe3                          ADD ZL, r19
00012f 2733                          CLR r19
000130 1ff3                          ADC ZH, r19
000131 952a                          DEC r18
000132 f7a1                          BRNE clear_bpm_area
                                 
                                     ; --- 2. BINARY TO BCD (Digit Splitting) ---
000133 2777                          CLR r23
000134 2788                          CLR r24
000135 2f91                          MOV r25, r17
                                 count_100:
000136 3694                          CPI r25, 100
000137 f018                          BRLO count_10
000138 5694                          SUBI r25, 100
000139 9573                          INC r23
00013a cffb                          RJMP count_100
                                 count_10:
00013b 309a                          CPI r25, 10
00013c f018                          BRLO draw_digits
00013d 509a                          SUBI r25, 10
00013e 9583                          INC r24
00013f cffb                          RJMP count_10
                                 
                                 draw_digits:
                                     ; --- 3. DRAW DIGITS ---
                                     ; Hundreds Digit (Y = 0)
000140 2377                          TST r23
000141 f021                          BREQ skip_hundreds ; Don't draw leading zero
000142 2fa7                          MOV r26, r23
000143 e245                          LDI px_x, 37
000144 e050                          LDI px_y, 0
000145 d013                          rcall Draw_Number_3x4
                                 skip_hundreds:
                                 
                                     ; Tens Digit (Y = 5)
000146 2fa8                          MOV r26, r24
000147 e245                          LDI px_x, 37
000148 e055                          LDI px_y, 5
000149 d00f                          rcall Draw_Number_3x4
                                 
                                     ; Units Digit (Y = 10)
00014a 2fa9                          MOV r26, r25
00014b e245                          LDI px_x, 37
00014c e05a                          LDI px_y, 10
00014d d00b                          rcall Draw_Number_3x4
                                 
                                     ; -- Restore Registers --
00014e 91ff                          POP ZH
00014f 91ef                          POP ZL
000150 915f                          POP px_y
000151 914f                          POP px_x
000152 91af                          POP r26
000153 919f                          POP r25
000154 918f                          POP r24
000155 917f                          POP r23
000156 913f                          POP r19
000157 912f                          POP r18
000158 9508                          RET
                                 
                                 ;---------------------------------------------------------
                                 ; Subroutine: Draw_Number_3x4
                                 ; Inputs: r26 (Digit 0-9), px_x (r20), px_y (r21)
                                 ;---------------------------------------------------------
                                 Draw_Number_3x4:
000159 93ef                          PUSH ZL
00015a 93ff                          PUSH ZH
00015b 932f                          PUSH r18
00015c 933f                          PUSH r19
00015d 934f                          PUSH px_x
00015e 935f                          PUSH px_y
                                 
00015f e0e2                          LDI ZL, low(Font3x4 * 2)
000160 e0f3                          LDI ZH, high(Font3x4 * 2)
000161 e024                          LDI r18, 4
000162 9fa2                          MUL r26, r18
000163 0de0                          ADD ZL, r0
000164 1df1                          ADC ZH, r1
                                 
000165 e024                          LDI r18, 4
                                 draw_row:
000166 9135                          LPM r19, Z+
                                 
000167 e060                          LDI px_state, 0
000168 fd32                          SBRC r19, 2
000169 e061                          LDI px_state, 1
00016a df3e                          rcall Set_Pixel
                                 
00016b 9543                          INC px_x
00016c e060                          LDI px_state, 0
00016d fd31                          SBRC r19, 1
00016e e061                          LDI px_state, 1
00016f df39                          rcall Set_Pixel
                                 
000170 9543                          INC px_x
000171 e060                          LDI px_state, 0
000172 fd30                          SBRC r19, 0
000173 e061                          LDI px_state, 1
000174 df34                          rcall Set_Pixel
                                 
000175 954a                          DEC px_x
000176 954a                          DEC px_x
000177 9553                          INC px_y
000178 952a                          DEC r18
000179 f761                          BRNE draw_row
                                 
00017a 915f                          POP px_y
00017b 914f                          POP px_x
00017c 913f                          POP r19
00017d 912f                          POP r18
00017e 91ff                          POP ZH
00017f 91ef                          POP ZL
000180 9508                          RET
                                 
                                 ;---------------------------------------------------------
                                 ; Font Data
                                 ;---------------------------------------------------------
                                 Font3x4:
000181 0507
000182 0705                          .db 0b111, 0b101, 0b101, 0b111  ; 0
000183 0206
000184 0702                          .db 0b110, 0b010, 0b010, 0b111  ; 1
000185 0107
000186 0706                          .db 0b111, 0b001, 0b110, 0b111  ; 2
000187 0207
000188 0701                          .db 0b111, 0b010, 0b001, 0b111  ; 3
000189 0505
00018a 0107                          .db 0b101, 0b101, 0b111, 0b001  ; 4
00018b 0407
00018c 0703                          .db 0b111, 0b100, 0b011, 0b111  ; 5
00018d 0407
00018e 0707                          .db 0b111, 0b100, 0b111, 0b111  ; 6
00018f 0107
000190 0202                          .db 0b111, 0b001, 0b010, 0b010  ; 7
000191 0507
000192 0707                          .db 0b111, 0b101, 0b111, 0b111  ; 8
000193 0507
000194 0107                          .db 0b111, 0b101, 0b111, 0b001  ; 9
                                 	;.db 0b000, 0b000, 0b000, 0b000  ; blank (for leading zero?)
                                 
                                 ; 3x4 Font:
                                 ; ##
                                 ;  #
                                 ;  #
                                 ; ###
                                 
                                 ; ###
                                 ;   #
                                 ; ##
                                 ; ###
                                 
                                 ; ###
                                 ;  #
                                 ;   #
                                 ; ###
                                 
                                 ; # #
                                 ; # #
                                 ; ###
                                 ;   #
                                 
                                 ; ###
                                 ; #
                                 ;  ##
                                 ; ###
                                 
                                 ; ###
                                 ; #
                                 ; ###
                                 ; ###
                                 
                                 ; ###
                                 ;   #
                                 ;  #
                                 ;  #
                                 
                                 ; ###
                                 ; # #
                                 ; ###
                                 ; ###
                                 
                                 ; ###
                                 ; # #
                                 ; ###
                                 ;   #
                                 
                                 ; ###
                                 ; # #
                                 ; # #
                                 ; ===#===
                                 
                                 ; -- LEDs
                                 .equ LED2_D = DDRc
                                 .equ LED2_P = PORTc
                                 .equ LED2_I = 2 ; or PC2
                                 .equ LED3_D = DDRc
                                 .equ LED3_P = PORTc
                                 .equ LED3_I = 3 ; or PC3
                                 
                                 ; ;buzzer
                                 ; .equ BZ_OUT_DIR = DDRb
                                 ; .equ BZ_OUT_BANK = PORTb
                                 ; .equ BZ_OUT_IDX = 1
                                 ; .equ BZ_OUT_PIN_TGL = PINb ; PINxn is PORTxn no need for DDRx for toggling
                                 ; ; we can just do SBI PINb,1 to toggle the buzzer pin
                                 ; .equ BZ_PORT = PORTb
                                 ; .equ BZ_TGL_PIN = PINb
                                 
                                 ; -- buzzer
                                 .equ BZ_D = DDRb
                                 .equ BZ_P = PORTb
                                 .equ BZ_I = 1
                                 
                                 ; === inputs ===
                                 ; -- switch
                                 .equ SW_D = DDRb
                                 .equ SW_P = PORTb ; to set pullup
                                 .equ SW_I = 0
                                 .equ SW_SENSE = PINb
                                 
                                 ; -- joystick
                                 ; TODO: how to handle the 4 directions?
                                 .equ JS_BTN_D = DDRb
                                 .equ JS_BTN_P = PORTb ; to set pullup
                                 .equ JS_BTN_I = 2
                                 .equ JS_BTN_SENSE = PINb
                                 ; need to use the ADC for the joystick directions
                                 .equ JS_X_D = DDRc
                                 .equ JS_X_I = 0 ; ADC0
                                 .equ JS_Y_D = DDRc
                                 .equ JS_Y_I = 1 ; ADC1
                                 
                                 ; -- keypad
                                 .equ KP_PIN = PINd
                                 .equ KP_DDR = DDRd
                                 .equ KP_PORT = PORTd
                                 ; see schematic:
                                 ; row1->4 = bit7->4 of PD
                                 .equ ROW1 = 7
                                 .equ ROW2 = 6
                                 .equ ROW3 = 5
                                 .equ ROW4 = 4
                                 ; col1->4 = bit3->0 of PD
                                 .equ COL1 = 3
                                 .equ COL2 = 2
                                 .equ COL3 = 1
                                 .equ COL4 = 0
                                 
                                 .include "inputs.asm"
                                 
                                 ; inputs.asm :
                                 ; PROJECT for Sensors and Microsystem Electronics, final file version
                                 ; Date : 2026
                                 ; Author : Lucas Placentino
                                 ; License: MIT
                                 ;
                                 
                                 Inputs_Init:
                                     ; ---- inputs init ----
                                     ; ---- ADC (for joystick) ----
                                     ; -- configure joystick (ADC) input pins
000195 9838                          cbi JS_X_D, JS_X_I ; set joystick x dir pin to input (0)
000196 9839                          cbi JS_Y_D, JS_Y_I ; set joystick y dir pin to input (0)
                                     ; -- configure ADMUX (multiplexer selection register)
                                     ; REFS0 = 1 -> AVCC (analog supply current) as voltage reference
                                     ; ADLAR = 1 -> ADC left adjust the result (only want 8-bit precision so we only read from ADCH)
                                     ; MUX3:0 = 0000 -> default: ADC0 (PC0 aka x-axis)
000197 e600                          ldi temp, (1<<REFS0) | (1<<ADLAR) ; no bit for mux since 0
000198 9300 007c                     sts ADMUX, temp
                                     ; -- configure ADCSRA (ADC Control and Status Register A)
                                     ; ADEN = 1 -> ADC enable
                                     ; ADPS2:0 = 111 -> prescaler of 128 (16MHz/128=125kHz ADC clock)
00019a e807                          ldi temp, (1<<ADEN) | (1<<ADPS2) | (1<<ADPS1) | (1<<ADPS0)
00019b 9300 007a                     sts ADCSRA, temp
                                     ; --------
                                 
                                     ; -- switch input
00019d 9820                          cbi SW_D, SW_I ; dir pin to 0 meaning input
00019e 9a28                          sbi SW_P, SW_I ; enable pullup for this input pin
                                 
                                     ; -- init JS click input
00019f 9822                          cbi JS_BTN_D, JS_BTN_I ; dir pin to 0 meaning input
0001a0 9a2a                          sbi JS_BTN_P, JS_BTN_I ; enable pullup for this input pin
                                 
                                     ; -- init JS states
0001a1 2700                          clr temp ; default joystick state
0001a2 9300 0128                     sts Prev_JS_Click, temp
0001a4 9300 0129                     sts Prev_JS_Down, temp
0001a6 9300 012a                     sts Prev_JS_Up, temp
0001a8 9300 012c                     sts Prev_JS_Right, temp
0001aa 9300 012b                     sts Prev_JS_Left, temp
                                 
                                     ; -- init keypad states
0001ac 9300 012d                     sts Prev_KP_0, temp
0001ae 9300 012e                     sts Prev_KP_1, temp
0001b0 9300 012f                     sts Prev_KP_2, temp
0001b2 9300 0130                     sts Prev_KP_3, temp
0001b4 9300 0131                     sts Prev_KP_4, temp
0001b6 9300 0132                     sts Prev_KP_5, temp
0001b8 9300 0133                     sts Prev_KP_6, temp
0001ba 9300 0134                     sts Prev_KP_7, temp
0001bc 9300 0135                     sts Prev_KP_8, temp
0001be 9300 0136                     sts Prev_KP_9, temp
0001c0 9300 0137                     sts Prev_KP_A, temp
0001c2 9300 0138                     sts Prev_KP_B, temp
0001c4 9300 0139                     sts Prev_KP_C, temp
0001c6 9300 013a                     sts Prev_KP_D, temp
0001c8 9300 013b                     sts Prev_KP_E, temp
0001ca 9300 013c                     sts Prev_KP_F, temp
                                 
                                     ; ----#----
0001cc 9508                          ret
                                 
                                 ; === handle user inputs (joystick, keypad) ===
                                 User_Inputs:
0001cd d037                          rcall Handle_Joystick
                                     ;rjmp kp_polling_1 ; ? rjmp or rcall ?
0001ce d0a2                          rcall Scan_Keypad ; ? rjmp or rcall ?
0001cf c3db                          rjmp loop
                                 ; ===#===
                                 
                                 ; === reset all btn states to 0 ===
                                 Reset_Prev_Btn_States:
0001d0 d002                          rcall Reset_Prev_JS_States
0001d1 d00f                          rcall Reset_Prev_KP_States
0001d2 9508                          ret
                                 
                                 Reset_Prev_JS_States:
0001d3 930f                          push temp
                                 
0001d4 2700                          clr temp ; ldi temp, 0
                                 
0001d5 9300 0128                     sts Prev_JS_Click, temp
0001d7 9300 0129                     sts Prev_JS_Down, temp
0001d9 9300 012a                     sts Prev_JS_Up, temp
0001db 9300 012c                     sts Prev_JS_Right, temp
0001dd 9300 012b                     sts Prev_JS_Left, temp
                                 
0001df 910f                          pop temp
0001e0 9508                          ret
                                 
                                 Reset_Prev_KP_States:
0001e1 930f                          push temp
                                 
0001e2 2700                          clr temp ; ldi temp, 0
                                 
0001e3 9300 012d                     sts Prev_KP_0, temp
0001e5 9300 012e                     sts Prev_KP_1, temp
0001e7 9300 012f                     sts Prev_KP_2, temp
0001e9 9300 0130                     sts Prev_KP_3, temp
0001eb 9300 0131                     sts Prev_KP_4, temp
0001ed 9300 0132                     sts Prev_KP_5, temp
0001ef 9300 0133                     sts Prev_KP_6, temp
0001f1 9300 0134                     sts Prev_KP_7, temp
0001f3 9300 0135                     sts Prev_KP_8, temp
0001f5 9300 0136                     sts Prev_KP_9, temp
0001f7 9300 0137                     sts Prev_KP_A, temp
0001f9 9300 0138                     sts Prev_KP_B, temp
0001fb 9300 0139                     sts Prev_KP_C, temp
0001fd 9300 013a                     sts Prev_KP_D, temp
0001ff 9300 013b                     sts Prev_KP_E, temp
000201 9300 013c                     sts Prev_KP_F, temp
                                 
000203 910f                          pop temp
000204 9508                          ret
                                 ; ===#===
                                 
                                 ; === handle joystick inputs ===
                                 Handle_Joystick:
000205 930f                          push temp
000206 931f                          push r17
000207 932f                          push r18
                                 
                                     ; FIXME:
                                     ; ; -- check JS click button
                                     ; sbis JS_BTN_SENSE, JS_BTN_I ; Skip if Bit in I/o reg is Set (skip if click not pressed), bc btn pulled up
                                     ; rcall Play_Pause_btn ; if click pressed, toggle play/pause
                                 
                                     ; -- check joystick click button
000208 2700                          clr temp ; assume button is pressed (0) ; ldi temp, 0
000209 991a                          sbic JS_BTN_SENSE, JS_BTN_I ; Skip next instruction if Bit in I/o reg is Cleared (0 aka pressed bc pulled-up)
00020a e001                          ldi temp, 1 ; If pin is HIGH, set temp to 1 (released)
                                     ; -- edge detection for btn
00020b 9110 0128                     lds r17, Prev_JS_Click
00020d 1701                          cp temp, r17
00020e f069                          breq Skip_Click_Check ; if state hasn't changed, skip toggle logic
00020f 9300 0128                     sts Prev_JS_Click, temp ; state changed, save the new physical state
000211 3001                          cpi temp, 1
000212 f049                          breq Skip_Click_Check ; if changed to 1 (btn released), skip toggle
                                     ; -- it changed to 0 (aka clicked)
                                     ; toggle play/pause state
000213 9110 0127                     lds r17, Is_Playing
000215 e021                          ldi r18, 1
000216 2712                          eor r17, r18 ; XOR flips 1 to 0, and 0 to 1
000217 9310 0127                     sts Is_Playing, r17
                                 
                                     ; instantly mute buzzer if just paused
000219 ff10                          sbrs r17, 0 ; skip mute if bit 0 is set (playing = 1)
00021a d322                          rcall Mute_Buzzer ; mute if paused (0) ; TODO: something else?
                                 
                                     ; TODO: ?
00021b c00d                          rjmp Handle_Joystick_End ; ignore rest of joystick handling if just clicked ?
                                 
                                     Skip_Click_Check:
                                 
                                     ; -- x-asix
00021c e020                          ldi r18, 0 ; joystick x-axis
00021d d041                          rcall Read_ADC ; read ADC value of joystick, store result in r19
00021e 3c30                          cpi r19, 192 ; compare with high threshold
00021f f4b0                          brsh joystick_right
000220 3430                          cpi r19, 64 ; compare with low threshold
000221 f058                          brlo joystick_left
                                     ; -- y-axis
000222 e021                          ldi r18, 1 ; joystick y-axis
000223 d03b                          rcall Read_ADC ; read ADC value of joystick, store result in r19
000224 3c30                          cpi r19, 192 ; compare with high threshold
000225 f4c8                          brsh joystick_down
000226 3430                          cpi r19, 64 ; compare with low threshold
000227 f108                          brlo joystick_up
                                 
                                     ; -- joystick in center (or in deadzone)
000228 c02a                          rjmp joystick_center
                                 
                                     Handle_Joystick_End:
                                 
000229 912f                          pop r18
00022a 911f                          pop r17
00022b 910f                          pop temp
00022c 9508                          ret
                                 
                                 joystick_left:
                                     ; -- reset states
00022d 2700                          clr temp ; default joystick state
00022e 9300 012a                     sts Prev_JS_Up, temp ; reset prev btn up state to 0 (no btn up)
000230 9300 0129                     sts Prev_JS_Down, temp ; reset prev btn down state to 0 (no btn down)
000232 9300 012c                     sts Prev_JS_Right, temp ; reset prev joystick x state to center
                                     ; -- move to previous step
000234 d1b9                          rcall Prev_Step_btn
000235 cff3                          rjmp Handle_Joystick_End
                                 joystick_right:
                                     ; -- reset states
000236 2700                          clr temp ; default joystick state
000237 9300 012a                     sts Prev_JS_Up, temp ; reset prev btn up state to 0 (no btn up)
000239 9300 0129                     sts Prev_JS_Down, temp ; reset prev btn down state to 0 (no btn down)
00023b 9300 012b                     sts Prev_JS_Left, temp ; reset prev joystick y state to center
                                     ; -- move to next step
00023d d19d                          rcall Next_Step_btn
00023e cfea                          rjmp Handle_Joystick_End
                                 joystick_down:
                                     ; -- reset states
00023f 2700                          clr temp ; default joystick state
000240 9300 012a                     sts Prev_JS_Up, temp ; reset prev btn up state to 0 (no btn up)
000242 9300 012c                     sts Prev_JS_Right, temp ; reset prev joystick x state to center
000244 9300 012b                     sts Prev_JS_Left, temp ; reset prev joystick y state to center
                                     ; -- decrease BPM
000246 d1df                          rcall Decr_BPM_btn
000247 d3bf                          rcall LED3_ON ; FIXME: DEBUG
000248 cfe0                          rjmp Handle_Joystick_End
                                 joystick_up:
                                     ; -- reset states
000249 2700                          clr temp ; default joystick state
00024a 9300 0129                     sts Prev_JS_Down, temp ; reset prev btn down state to 0 (no btn down)
00024c 9300 012c                     sts Prev_JS_Right, temp ; reset prev joystick x state to center
00024e 9300 012b                     sts Prev_JS_Left, temp ; reset prev joystick y state to center
                                     ; -- increase BPM
000250 d1c2                          rcall Incr_BPM_btn
000251 d3b1                          rcall LED2_ON ; FIXME: DEBUG
000252 cfd6                          rjmp Handle_Joystick_End
                                 
                                 ; FIXME: for DEBUG:
                                 joystick_center:
                                     ; -- reset states
000253 2700                          clr temp ; default joystick state
000254 9300 012a                     sts Prev_JS_Up, temp ; reset prev btn up state to 0 (no btn up)
000256 9300 0129                     sts Prev_JS_Down, temp ; reset prev btn down state to 0 (no btn down)
000258 9300 012c                     sts Prev_JS_Right, temp ; reset prev joystick x state to center
00025a 9300 012b                     sts Prev_JS_Left, temp ; reset prev joystick y state to center
00025c d3a8                          rcall LED2_OFF
00025d d3ab                          rcall LED3_OFF
00025e cfca                          rjmp Handle_Joystick_End
                                 
                                 Read_ADC:
                                     ; input: r18 = ADC channel to read (0-7)
                                     ; output: r19 = ADC value (0-255)
00025f 930f                          push temp
                                 
                                     ; -- set channel
                                     ; TODO: necessary ?
000260 702f                          andi r18, 0b00001111 ; channel must be 0-15 because MUX3:0 are only 4 bits
000261 6620                          ori r18, (1<<REFS0) | (1<<ADLAR) ; apply reference and left-adjust bits again (see setup)
000262 9320 007c                     sts ADMUX, r18 ; write to ADMUX to set channel (and reference/adjust bits again like in setup)
                                 
                                 
                                 
                                     ; -- start conversion
000264 9100 007a                     lds temp, ADCSRA ; read current value of ADC Control and Status Register A
000266 6400                          ori temp, (1<<ADSC) ; set the ADC Start Conversion bit
000267 9300 007a                     sts ADCSRA, temp
                                 
                                     Wait_For_ADC:
                                     ; -- wait for the conversion end
                                     ; QDC hardware will automatically clear the ADSC bit when done
000269 9100 007a                     lds temp, ADCSRA
00026b fd06                          sbrc temp, ADSC ; skip next if ADSC is 0
00026c cffc                          rjmp Wait_For_ADC ; loop back up
                                 
                                     ; -- get value result
00026d 9130 0079                     lds r19, ADCH ; output (read only the high byte for 8-bit resolution)
                                 
                                     ; restore
00026f 910f                          pop temp
000270 9508                          ret
                                 ; ===#===
                                 
                                 ; === Keypad scanning/polling routine step 2 ===
                                 ; making this a macro can make it more elegant
                                 ;KP_POLLING_2:
                                 .macro KP_POLLING_2
                                     ; careful: need to first modify PORT reg before modifying DDR reg.
                                     ; rows as inputs:
                                     ldi temp,(1<<ROW1)|(1<<ROW2)|(1<<ROW3)|(1<<ROW4)
                                     out KP_PORT,temp ; bitmask to keypad port for rows
                                     ; cols as outputs:
                                     ldi temp,(1<<COL1)|(1<<COL2)|(1<<COL3)|(1<<COL4)
                                     out KP_DDR,temp     ; bitmask to keypad port dir for cols
                                 
                                     nop ; No operation because "Add NOP when changing output connected to an input" slide 8 ("Bits in PINx register are always one cycle behind", synchronizer: PIN reg 1 clk-cycle late)
                                     ; now we can read PIN reg
                                 
                                     ;ldi row,0x0 ; default nothing pressed
                                     sbis KP_PIN,ROW1
                                     ; rcall or rjmp to colY row X=1
                                     ;ldi row,0x1
                                     rjmp @0 ; rjmp to first arg of macro
                                 
                                     sbis KP_PIN,ROW2
                                     ; rcall or rjmp to colY row X=2
                                     ;ldi row,0x2
                                     rjmp @1 ; rjmp to second arg of macro
                                 
                                     sbis KP_PIN,ROW3
                                     ; rcall or rjmp to colY row X=3
                                     ;ldi row,0x3
                                     rjmp @2 ; rjmp to third arg of macro
                                 
                                     sbis KP_PIN,ROW4
                                     ; rcall or rjmp to colY row X=4
                                     ;ldi row,0x4
                                     rjmp @3 ; rjmp to fourth arg of macro
                                 
                                     rjmp no_kp_pressed
                                     ret ; i guess shoudln't happen
                                 .endmacro
                                 ; ===#===
                                 
                                 ; === Keypad scanning/polling routine ===
                                 ; this does the "2-step method" switching for the keypad
                                 ; - config all rows output, set them LOW
                                 ; - config all cols input, check which low
                                 ;    - the col y that is low has a btn pressed => col num Y
                                 ;    - config all rows input, all cols output
                                 ;    - => careful transition, intermediate pin states ! context switching
                                 ;    - set all cols to LOW, check row pins
                                 ;        - if all rows HIGH => btn release, exit
                                 ;        - if row x is LOW => btn pressed in Y col => row num X
                                 ;        - => btn pressed is row-X and col-Y
                                 ; - if no col is low (=all high) no btn is pressed, exit
                                 Scan_Keypad:
                                 kp_polling_1:
                                     ; careful: need to first modify PORT reg before modifying DDR reg.
                                     ; cols as inputs:
000271 e00f                          ldi temp,(1<<COL1)|(1<<COL2)|(1<<COL3)|(1<<COL4)
000272 b90b                          out KP_PORT,temp ; bitmask to keypad port for cols
                                     ; rows as outputs set LOW:
000273 ef00                          ldi temp,(1<<ROW1)|(1<<ROW2)|(1<<ROW3)|(1<<ROW4)
000274 b90a                          out KP_DDR,temp ; bitmask to keypad port dir for rows
                                 
000275 0000                          nop ; No operation because "Add NOP when changing output connected to an input" slide 8 ("Bits in PINx register are always one cycle behind", synchronizer: PIN reg 1 clk-cycle late)
                                     ; now we can read PIN reg
                                 
000276 9b4b                          sbis KP_PIN,COL1
                                     ; rcall or rjmp to KP_POLLING_2 as col Y=1 or set a reg to some value?
                                     ;ldi col,0x1
000277 c00a                          rjmp col1pressed
                                 
000278 9b4a                          sbis KP_PIN,COL2
                                     ; rcall or rjmp to KP_POLLING_2 as col Y=2
                                     ;ldi col,0x2
000279 c018                          rjmp col2pressed
                                 
00027a 9b49                          sbis KP_PIN,COL3
                                     ; rcall or rjmp to KP_POLLING_2 as col Y=3
                                     ;ldi col,0x3
00027b c026                          rjmp col3pressed
                                 
00027c 9b48                          sbis KP_PIN,COL4
                                     ; rcall or rjmp to KP_POLLING_2 as col Y=4
                                     ;ldi col,0x4
00027d c034                          rjmp col4pressed
                                 
                                     ; nothing was pressed
00027e c001                          rjmp no_kp_pressed
00027f 9508                          ret ; i guess shoudln't happen
                                 
                                 no_kp_pressed:
                                     ; TODO: do something/nothing ?
000280 df60                          rcall Reset_Prev_KP_States ; reset all btn states to 0 (no btn pressed)
000281 9508                          ret
                                 
                                 col1pressed:
                                     ; col Y=1
                                     ;rcall KP_POLLING_2 ; check row X value => in reg `row` after this func call
