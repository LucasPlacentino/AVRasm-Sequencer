                                 ; .equ TCNT1_RESET_A4 = 47354 ; 440.00 Hz
                                 ; .equ TCNT1_RESET_AS4 = 48375 ; 466.16 Hz (A#)
                                 ; .equ TCNT1_RESET_B4 = 49338 ; 493.88 Hz
                                 ; .equ TCNT1_RESET_C5 = 50247 ; 523.25 Hz
