                                 ; ; %%%%%%%%%%%%%%%%%% OLD %%%%%%%%%%%%%%%%%%
                                 ; ; Timer1 reset value for overflow timing
                                 ; ; tcnt1 = 65536 - round(16MHz/(2*freq_sound))
                                 ; ; e.g: .equ TCNT1_RESET_880 = 47354  ;440Hz (880Hz because toggle) ? A
                                 ; .equ TCNT1_RESET_C4 = 34958 ; 261.63 Hz
